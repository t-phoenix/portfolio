# Thought Leadership Signal — Publish credentials
# Copy to .env and fill. Never commit .env.

# LinkedIn (free Share on LinkedIn product)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=

# --- X: prefer Official API (pay-per-use, post-only) ---
# Create app at https://console.x.com → User authentication → Read and write
# Keys → API Key/Secret + Access Token/Secret (for @touchey_phoenix)
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# auto | official | twitterapi
X_PROVIDER=auto
# URL posts cost ~$0.20 vs ~$0.015 — keep false
X_ALLOW_URLS=false
X_SCREEN_NAME=touchey_phoenix

# --- X fallback: twitterapi.io (needs cookies + residential proxy) ---
TWITTERAPI_API_KEY=
TWITTERAPI_LOGIN_COOKIES=
TWITTERAPI_AUTH_SESSION=
X_PROXY_URL=
X_USER_NAME=touchey_phoenix
X_EMAIL=
X_PASSWORD=
X_TOTP_SECRET=

# Optional: dry run (log only, do not post)
PUBLISH_DRY_RUN=true

# Timezone for suggestions
SIGNAL_TIMEZONE=Asia/Kolkata
